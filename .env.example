# Copy this file to `.env` and fill in the values.
# The analysis pipeline still runs fine with everything empty (structural
# ranking only) — this file just documents what the AI layer needs.

# OpenRouter API key for the AI-assisted onboarding ranking layer.
# When unset, the AI layer is skipped entirely and pure structural ranking
# is used. NEVER commit the real key.
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Model used for per-file classification. Picked fast + cheap because we make
# ~25 calls per repo. Swap here (or via env) if you want a different model.
# Free-tier picks that work well:
#   google/gemma-4-26b-a4b-it:free   (fast, reliable — the default)
#   openai/gpt-oss-20b:free          (gpt-family; slower, occasionally 429)
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# Set this to "false" to fully disable the AI layer and revert to the pure
# deterministic structural ranking (import count + complexity).
# ENABLE_AI_RANKING=true

# Optional: point the AI layer at any OpenAI-compatible endpoint. Useful for
# testing against a local mock (e.g. http://127.0.0.1:8787/v1).
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Infrastructure (defaults work locally; set these when deploying) ---
# MongoDB connection string. Defaults to the local server + "wayfinder" db.
# WAYFINDER_MONGO_URL=mongodb://127.0.0.1:27017

# Redis for live progress ticks. Defaults to 127.0.0.1:6379 with no password.
# Set the HOST to a remote value (e.g. a Zerops Valkey hostname) to skip the
# auto-booted embedded Redis.
# WAYFINDER_REDIS_HOST=127.0.0.1
# WAYFINDER_REDIS_PORT=6379
# WAYFINDER_REDIS_PASSWORD=

# When "true", the API does NOT spawn a worker child process — it queues jobs
# in MongoDB for a separate long-running worker service (worker/poller.py) to
# pick up. Use this for the Zerops 3-service deployment. Leave unset locally.
# WAYFINDER_EXTERNAL_WORKER=true

# Python executable the API spawns for a worker (local spawn mode only).
# PYTHON_BIN=python
